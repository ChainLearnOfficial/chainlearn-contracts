# ──────────────────────────────────────────────────────────────────────────────
# gas-thresholds.env — Per-operation CPU instruction thresholds for CI
# ──────────────────────────────────────────────────────────────────────────────
#
# Used by ./scripts/estimate-gas.sh and the "Gas benchmark regression check"
# step in .github/workflows/ci.yml. Each entry maps a benchmark operation to the
# maximum CPU instruction cost it may report. The check fails if any measured
# operation exceeds its threshold.
#
# How to update thresholds:
#   1. Run ./scripts/estimate-gas.sh locally and read the reported costs.
#   2. Set each threshold with headroom above the observed cost so genuine
#      regressions are caught without flaking on small host-version variance.
#      The in-test baselines in tests/benchmarks/gas_benchmarks.rs use 2x the
#      observed cost; keep these values in the same ballpark.
#   3. Commit the updated file together with the change that moved the cost.
#
# When DEFAULT_GAS_LIMIT is set, operations not listed below fall back to it.
# When it is unset (or 0), unlisted operations are not gated.
# ──────────────────────────────────────────────────────────────────────────────

# Fallback for operations without an explicit threshold (0 = not gated).
DEFAULT_GAS_LIMIT=100000000

# ── progress-tracker ──────────────────────────────────────────────────────────
GAS_LIMIT_create_course=1000000
GAS_LIMIT_enroll=400000
GAS_LIMIT_complete_module=500000
GAS_LIMIT_submit_quiz_score=400000
GAS_LIMIT_get_progress=60000

# ── learn-token ───────────────────────────────────────────────────────────────
GAS_LIMIT_claim_reward=900000
GAS_LIMIT_transfer=250000
GAS_LIMIT_approve=300000
GAS_LIMIT_transfer_from=300000
GAS_LIMIT_mint=400000
GAS_LIMIT_burn=250000

# ── credential-nft ────────────────────────────────────────────────────────────
GAS_LIMIT_mint_credential=800000
GAS_LIMIT_verify_credential=100000
GAS_LIMIT_revoke_credential=400000
